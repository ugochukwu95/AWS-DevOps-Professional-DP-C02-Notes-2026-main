# Applied by `make pg-endpoint`, which replaces PG_IP with the taskq-pg container's
# IP on the kind Docker network. Delete both objects when Postgres moves into the
# cluster (note 08).
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: taskq
spec:
  ports:
    - name: postgres
      port: 5432
      targetPort: 5432
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: postgres-external
  namespace: taskq
  labels:
    kubernetes.io/service-name: postgres
addressType: IPv4
ports:
  - name: postgres
    port: 5432
    protocol: TCP
endpoints:
  - addresses: ["PG_IP"]
